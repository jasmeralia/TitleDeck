{
  "name": "titledeck",
  "version": "1.5.0-beta.1",
  "private": true,
  "description": "TitleDeck: local Steam library titles, descriptions, and display customization.",
  "type": "module",
  "license": "MIT",
  "author": "Valentine",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "build": "npm run version:sync && npm run version:check",
    "release:zip": "python3 scripts/make-release.py"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "steam",
    "rename",
    "library"
  ],
  "dependencies": {
    "entities": "9.0.0",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
